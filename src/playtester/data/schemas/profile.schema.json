{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Preponderous-Software/playtester/src/playtester/data/schemas/profile.schema.json",
  "title": "Playtester game profile",
  "description": "Everything the harness needs to know about one game (docs/PROFILES.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "description",
    "launch",
    "window"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The game's name, as agents should call it"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence an agent reads first"
    },
    "repository": {
      "type": "string",
      "description": "owner/name on GitHub, for issues and evidence"
    },
    "driver": {
      "enum": [
        "x11",
        "strata",
        "windows"
      ],
      "description": "How the harness runs and drives the game: x11 (default) gives it its own Xvfb and drives it with xdotool; strata runs a Strata game headless and drives it through its drive channel (Strata ABI 1.12, STRATA_DRIVE), with no X server; windows runs a Windows game on the real desktop of the machine hosting WSL2 and drives it with real input, one session at a time (docs/PROFILES.md#drivers)"
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process"
      ],
      "description": "The Windows driver's settings (driver windows only). Strings may use the launch placeholders and {module}",
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1,
          "description": "The game's process name, without .exe (Get-Process -Name)"
        },
        "min_width": {
          "type": "integer",
          "minimum": 0,
          "description": "The game's window is at least this wide (smaller windows of the process are its launcher)"
        },
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title_regex": {
              "type": "string",
              "description": "The launcher dialog's title (default any)"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keys that start the game from the launcher once it is in front (default Return)"
            },
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "click": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Where the launcher's start button is, as fractions [x, y] of its client area: clicked when Windows will not bring the launcher to the front for keys (a click both activates it and starts the game)"
            }
          }
        },
        "module": {
          "type": "string",
          "description": "Default for {module} (pt start --module or PT_MODULE override it)"
        },
        "registry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "name",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^(HKCU|HKLM)\\\\"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "description": "Values pt start sets before launching (and pt stop puts back), e.g. the module the launcher picks"
        },
        "log": {
          "type": "string",
          "description": "The game's log file (WSL path); pt reads it into game.log and the log probe (windows_log)"
        },
        "log_prefix": {
          "type": "string",
          "minLength": 1,
          "description": "Log lines with this become probe events (default PTPROBE)"
        },
        "probe_format": {
          "type": "string",
          "enum": [
            "keyvalue",
            "ptline"
          ],
          "description": "How probe lines are written: keyvalue (default; PREFIX TYPE key=value ... in the log, windows_log) or ptline (the short checked lines of docs/PROBE_LINES.md, read from the log and by OCR)"
        },
        "ocr": {
          "type": "object",
          "additionalProperties": false,
          "description": "Read probe lines off the screen (windows_ocr; needs tesseract on PATH and probe_format ptline): pt start runs a reader that captures the region every interval_sec, keeps the probe colour and runs OCR",
          "properties": {
            "rect": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "The region to read, as fractions [left, top, right, bottom] of the game window's client area"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "The probe lines' colour (#RRGGBB)"
            },
            "tolerance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Largest channel difference from color still kept (default 90)"
            },
            "scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4,
              "description": "Scale the region by this before OCR (default 1)"
            },
            "interval_sec": {
              "type": "number",
              "minimum": 0.2,
              "description": "Seconds between captures (default 1.5)"
            },
            "psm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 13,
              "description": "tesseract page segmentation mode (default 6, a block of text)"
            },
            "whitelist": {
              "type": "string",
              "description": "Characters tesseract may read (default PTSMEB0123456789-)"
            }
          }
        },
        "log_error_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regular expressions; matching log lines become log_error events"
        },
        "close_timeout_sec": {
          "type": "number",
          "minimum": 0,
          "description": "pt stop waits this long after asking the game to close before killing it (default 15)"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command, run in the game's checkout, that builds what launch.command runs"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools the build needs on PATH"
        },
        "artifact": {
          "type": "string",
          "description": "The built file whose modification time is the build's time (placeholders as in launch); defaults to launch.command[0] when it is inside the game's checkout"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Always passed after command"
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env_defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Set only when unset and the value is an existing path"
        },
        "seed_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Passed when pt start --seed S is given; {seed} is S"
        },
        "quick_world_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments that start straight in a world (pt measure)"
        },
        "start_timeout_sec": {
          "type": "number",
          "minimum": 1
        },
        "settle_sec": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds to wait after the window appears, for games whose first frames are blank"
        },
        "lp_threads": {
          "type": "integer",
          "minimum": 1,
          "description": "llvmpipe threads per game (LP_NUM_THREADS) unless PT_LP_THREADS is set; default 2"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "title_regex": {
          "type": "string",
          "minLength": 1,
          "description": "xdotool search --name pattern for the game's window (required unless driver is strata)"
        },
        "width": {
          "type": "integer",
          "minimum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 64
        }
      }
    },
    "probe": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "flag",
        "ticks_per_second"
      ],
      "properties": {
        "flag": {
          "type": "string",
          "description": "The game's option taking the probe directory, e.g. --playtest-out"
        },
        "ticks_per_second": {
          "type": "number",
          "minimum": 1,
          "description": "Simulation ticks per second of game time"
        },
        "world_screens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Screens on which face and walkto work (default WORLD)"
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The screen names the game reports, for agents"
        },
        "since": {
          "type": "string",
          "description": "The first game version or commit with the probe"
        }
      }
    },
    "movement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "turn"
      ],
      "properties": {
        "turn": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "left",
                "right",
                "degrees_per_second"
              ],
              "properties": {
                "method": {
                  "const": "keys"
                },
                "left": {
                  "type": "string"
                },
                "right": {
                  "type": "string"
                },
                "degrees_per_second": {
                  "type": "number",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "pixels_per_degree"
              ],
              "properties": {
                "method": {
                  "const": "mouse"
                },
                "pixels_per_degree": {
                  "type": "number",
                  "description": "Relative pointer pixels per degree turned right (negative if moving right turns left)"
                }
              }
            }
          ]
        },
        "yaw_increases": {
          "enum": [
            "left",
            "right"
          ],
          "description": "Which way state.json's player.yawDeg grows when the player turns"
        },
        "forward_key": {
          "type": "string"
        },
        "speed_field": {
          "type": "string",
          "description": "The player field with the walking speed (default speed)"
        },
        "default_speed": {
          "type": "number",
          "minimum": 0.01
        },
        "interact_key": {
          "type": "string"
        },
        "interact_range": {
          "type": "number",
          "minimum": 0
        },
        "stop_distance": {
          "type": "number",
          "minimum": 0,
          "description": "walkto stops closer than this"
        },
        "face_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "nearest_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "crash_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regular expressions that mark a crash in game.log"
    },
    "process_name": {
      "type": "string",
      "description": "What pgrep -f matches for a running game, for cleanup checks"
    },
    "agent_notes": {
      "type": "string",
      "description": "Markdown file (relative to the profile) with controls and tips for agents"
    },
    "cheats": {
      "type": "string",
      "description": "What agents must not press or pass unless their goal says so"
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "seed": {
          "type": [
            "integer",
            "string"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "steps"
          ],
          "properties": {
            "event": {
              "type": "object"
            },
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "may_fail": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Commands whose failure only ends this attempt"
            }
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "budget_min": {
            "type": "number",
            "minimum": 1
          },
          "seed": {
            "type": [
              "integer",
              "string"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Questions every agent answers in its report's answers, at the end of the session; pt aggregate collects the answers by question"
    },
    "evidence_dir": {
      "type": "string",
      "description": "Where in the game's repository playtest evidence is committed (default docs/playtests)"
    }
  },
  "if": {
    "required": [
      "driver"
    ],
    "properties": {
      "driver": {
        "const": "strata"
      }
    }
  },
  "else": {
    "properties": {
      "window": {
        "required": [
          "title_regex"
        ]
      }
    }
  }
}
